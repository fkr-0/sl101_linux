[Desktop Entry]
Type=Application
Name=Web Browser
GenericName=Web Browser
Comment=Browse the web (Epiphany via Grate GPU)
Exec=/usr/local/bin/sl101-epiphany %u
Icon=web-browser
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=false
