# NuraLoumi sway config — SL101 Eee Pad Slider

# --- Input ---
input "type:touch" {
    map_to_output LVDS-1
    calibration_matrix 1 0 -0.02 0 -1 1
}

input "type:keyboard" {
    xkb_layout de
}

# --- Output ---
output LVDS-1 {
    mode 1280x800@58.632Hz
}

# --- Appearance ---
# Floating by default (stacking WM feel)
# All new windows float unless tiled explicitly
for_window [app_id=".*"] floating enable
for_window [class=".*"] floating enable

# Thin borders, no titlebar clutter
default_border pixel 2
default_floating_border pixel 2
font pango:Open Sans 11

# Touch-friendly titlebar when needed
titlebar_padding 8 4
titlebar_border_thickness 1

# Colors: dark theme
# class                 border  bg      text    indicator child_border
client.focused          #4c7899 #285577 #ffffff #2e9ef4   #4c7899
client.unfocused        #333333 #222222 #888888 #292d2e   #333333

# --- Window management ---
# Super + touch/mouse drag = move; Super + right-drag = resize
floating_modifier Mod4 normal

# --- Keybinds ---
set $mod Mod4

# Terminal
bindsym $mod+Return exec /usr/local/bin/sl101-foot-launch

# NuraLoumi shell
bindsym $mod+d exec /usr/local/bin/sl101-nuraloumi run --live --path-complete --recent-files
bindsym $mod+e exec /usr/local/bin/sl101-nuraloumi files --live
bindsym Mod1+Tab exec /usr/local/bin/sl101-nuraloumi windows --live

# Window control
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+q kill
bindsym $mod+Shift+r reload

# Snap to edges (tiling-like)
bindsym $mod+Left move left
bindsym $mod+Right move right
bindsym $mod+Up move up
bindsym $mod+Down move down

# Snap half-screen (resize + move)
bindsym $mod+bracketleft exec swaymsg 'move position 0 0, resize set 640 800'
bindsym $mod+bracketright exec swaymsg 'move position 640 0, resize set 640 800'

# Focus
bindsym $mod+Tab focus next
bindsym $mod+Shift+Tab focus prev

# SL101 utilities
bindsym $mod+u exec /usr/local/bin/sl101-cog-url
bindsym $mod+b exec /usr/local/bin/sl101-browse

# Workspaces (keyd now preserves Super+digit)
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5
bindsym $mod+Shift+6 move container to workspace number 6
bindsym $mod+Shift+7 move container to workspace number 7
bindsym $mod+Shift+8 move container to workspace number 8
bindsym $mod+Shift+9 move container to workspace number 9

# Physical RightAlt+LeftCtrl+digit emits Ctrl+Alt+Fn via keyd.
# The chvt wrapper requires an independently verified NOPASSWD sudo rule.
bindsym Ctrl+Mod1+F1 exec sudo -n /usr/local/bin/sl101-chvt 1
bindsym Ctrl+Mod1+F2 exec sudo -n /usr/local/bin/sl101-chvt 2
bindsym Ctrl+Mod1+F3 exec sudo -n /usr/local/bin/sl101-chvt 3
bindsym Ctrl+Mod1+F4 exec sudo -n /usr/local/bin/sl101-chvt 4
bindsym Ctrl+Mod1+F5 exec sudo -n /usr/local/bin/sl101-chvt 5
bindsym Ctrl+Mod1+F6 exec sudo -n /usr/local/bin/sl101-chvt 6
bindsym Ctrl+Mod1+F7 exec sudo -n /usr/local/bin/sl101-chvt 7
bindsym Ctrl+Mod1+F8 exec sudo -n /usr/local/bin/sl101-chvt 8
bindsym Ctrl+Mod1+F9 exec sudo -n /usr/local/bin/sl101-chvt 9

# Volume
bindsym XF86AudioRaiseVolume exec amixer -c 0 sset 'Speaker' 5%+ && amixer -c 0 sset 'Headphone' 5%+
bindsym XF86AudioLowerVolume exec amixer -c 0 sset 'Speaker' 5%- && amixer -c 0 sset 'Headphone' 5%-

# --- Autostart ---
exec /usr/local/bin/sl101-nuraloumi panel --live

# No swaybar — NuraLoumi panel handles status
bar {
    mode invisible
}
