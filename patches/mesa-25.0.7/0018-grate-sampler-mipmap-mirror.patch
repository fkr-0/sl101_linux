+/* Invalid sampler/mip combinations must never draw using stale GR3D state.
+ * GL incomplete-texture fallback remains a separate state-tracker obligation.
+ */
+bool
+grate_sampler_bindings_supported(struct grate_context *context)
+{
+   for (unsigned i = 0; i < 16; ++i) {
+      struct grate_sampler_state *sampler = context->samplers[i];
+      struct pipe_sampler_view *view = context->sampler_views[i];
+      unsigned required;
+
+      if (!sampler)
+         continue;
+      if (!view || view->target != PIPE_TEXTURE_2D ||
+          view->u.tex.first_level != 0)
+         return false;
+      if (sampler->base.min_mip_filter == PIPE_TEX_MIPFILTER_NONE)
+         continue;
+      required = MAX2(grate_texture_log2(view->texture->width0),
+                      grate_texture_log2(view->texture->height0));
+      if (!grate_texture_is_pow2(view->texture->width0) ||
+          !grate_texture_is_pow2(view->texture->height0) ||
+          view->u.tex.last_level != required)
+         return false;
+   }
+   return true;
+}
