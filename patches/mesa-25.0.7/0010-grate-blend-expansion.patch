+/*
+ * Compile each blend variant from the same base IR. The source-over helper
+ * consumes the original DW and appends EXEC/ALU nodes, so reusing its result
+ * for another blend would silently build an incorrect cumulative program.
+ */
+static bool
+grate_fp_shader_clone(const struct grate_fp_shader *source,
+                      struct grate_fp_shader *copy)
+{
+   *copy = *source;
+   list_inithead(&copy->fp_instructions);
+   list_inithead(&copy->mfu_instructions);
+   list_inithead(&copy->alu_instructions);
+
+#define CLONE_INSTRUCTIONS(type, member) do {                            \
+   list_for_each_entry(struct type, orig, &source->member, link) {       \
+      struct type *item = CALLOC_STRUCT(type);                           \
+      if (!item)                                                         \
+         goto oom;                                                       \
+      *item = *orig;                                                     \
+      list_inithead(&item->link);                                       \
+      list_addtail(&item->link, &copy->member);                          \
+   }                                                                    \
+} while (0)
+   CLONE_INSTRUCTIONS(fp_instr, fp_instructions);
+   CLONE_INSTRUCTIONS(fp_mfu_instr, mfu_instructions);
+   CLONE_INSTRUCTIONS(fp_alu_instr_packet, alu_instructions);
+#undef CLONE_INSTRUCTIONS
+   return true;
+
+oom:
+   grate_fp_shader_cleanup(copy);
+   return false;
+}
+
+static struct fp_alu_src_operand
+grate_blend_src(unsigned reg, bool high)
+{
+   return (struct fp_alu_src_operand) {
+      .enable = true, .index = reg, .datatype = FP_DATATYPE_FIXED10,
+      .sub_reg_select_high = high,
+   };
+}
+
+static struct fp_alu_dst_operand
+grate_blend_dst(unsigned reg, bool high, bool saturate)
+{
+   return (struct fp_alu_dst_operand) {
+      .index = reg, .write_low_sub_reg = !high,
+      .write_high_sub_reg = high, .saturate = saturate,
+   };
+}
+
+static struct fp_alu_src_operand
+grate_blend_const(bool one, bool enabled)
+{
+   struct fp_alu_src_operand src = grate_blend_src(FP_LOWP_CONST_REG, one);
+   src.enable = enabled;
+   return src;
+}
+
+static struct fp_alu_instr
+grate_blend_mad(struct fp_alu_dst_operand dst,
+                struct fp_alu_src_operand a, struct fp_alu_src_operand b,
+                struct fp_alu_src_operand c)
+{
+   return (struct fp_alu_instr) {
+      .op = FP_ALU_OP_MAD, .dst = dst,
+      .src = { a, b, c, grate_blend_const(true, false) },
+   };
+}
+
+static struct fp_alu_instr
+grate_blend_mov(struct fp_alu_dst_operand dst,
+                struct fp_alu_src_operand src)
+{
+   return grate_blend_mad(dst, src, grate_blend_const(true, true),
+                          grate_blend_const(false, true));
+}
+
+static struct fp_alu_instr
+grate_blend_mul(struct fp_alu_dst_operand dst,
+                struct fp_alu_src_operand a, struct fp_alu_src_operand b)
+{
+   return grate_blend_mad(dst, a, b, grate_blend_const(false, true));
+}
+
+/* Preserve only the single color DW; stencil and MRT are not implemented. */
+static bool
+grate_blend_take_color_output(struct grate_fp_shader *fp, int *rt)
+{
+   if (fp->failed)
+      return false;
+
+   *rt = -1;
+   list_for_each_entry(struct fp_instr, inst, &fp->fp_instructions, link) {
+      if (!inst->dw.enable)
+         continue;
+      if (*rt >= 0 && *rt != inst->dw.index)
+         return false;
+      if (inst->dw.stencil_write)
+         return false;
+      *rt = inst->dw.index;
+   }
+   if (*rt < 0)
+      return false;
+
+   list_for_each_entry(struct fp_instr, inst, &fp->fp_instructions, link)
+      inst->dw.enable = false;
+   return true;
+}
+
+static struct fp_instr *
+grate_blend_exec(unsigned address, bool destination_fetch, int rt)
+{
+   struct fp_instr *inst = CALLOC_STRUCT(fp_instr);
+   if (!inst)
+      return NULL;
+
+   list_inithead(&inst->link);
+   inst->alu_sched.address = address;
+   inst->alu_sched.num_instructions = 1;
+   if (destination_fetch) {
+      inst->pseq = 0x0081000a;
+      inst->dw.enable = true;
+      inst->dw.index = rt;
+      inst->dw.src_regs = FP_DW_REGS_R0_R1;
+   }
+   return inst;
+}
+
+static struct fp_alu_instr_packet *
+grate_blend_packet(void)
+{
+   struct fp_alu_instr_packet *packet =
+      CALLOC_STRUCT(fp_alu_instr_packet);
+   if (packet)
+      list_inithead(&packet->link);
+   return packet;
+}
+
+static bool
+grate_fp_enable_additive_blend(struct grate_fp_shader *fp)
+{
+   struct fp_instr *save = NULL, *blend = NULL;
+   struct fp_alu_instr_packet *save_alu = NULL, *blend_alu = NULL;
+   int rt;
+
+   if (!grate_blend_take_color_output(fp, &rt))
+      return false;
+   if (!grate_fp_program_counts_supported(
+          list_length(&fp->fp_instructions) + 2,
+          list_length(&fp->mfu_instructions),
+          list_length(&fp->alu_instructions) + 2))
+      return false;
+
+   const unsigned next = list_length(&fp->alu_instructions);
+   save = grate_blend_exec(next, false, rt);
+   blend = grate_blend_exec(next + 1, true, rt);
+   save_alu = grate_blend_packet();
+   blend_alu = grate_blend_packet();
+   if (!save || !blend || !save_alu || !blend_alu)
+      goto oom;
+
+   for (unsigned c = 0; c < 4; ++c) {
+      const bool high = c & 1;
+      const unsigned out = c / 2;
+      const unsigned input = 2 + out;
+      save_alu->slots[c] =
+         grate_blend_mov(grate_blend_dst(out, high, false),
+                         grate_blend_src(input, high));
+      /* Saturate ADD(src,dst) to the fixed10 render-target range. */
+      blend_alu->slots[c] =
+         grate_blend_mad(grate_blend_dst(out, high, true),
+                         grate_blend_src(input, high),
+                         grate_blend_const(true, true),
+                         grate_blend_src(out, high));
+   }
+
+   list_addtail(&save_alu->link, &fp->alu_instructions);
+   list_addtail(&blend_alu->link, &fp->alu_instructions);
+   list_addtail(&save->link, &fp->fp_instructions);
+   list_addtail(&blend->link, &fp->fp_instructions);
+   fp->info.pseq_to_dw_exec_nb = list_length(&fp->fp_instructions);
+   return true;
+
+oom:
+   FREE(save); FREE(blend); FREE(save_alu); FREE(blend_alu);
+   return false;
+}
+
+static bool
+grate_fp_enable_standard_alpha_blend(struct grate_fp_shader *fp)
+{
+   struct fp_instr *premul = NULL, *premul_alpha = NULL, *blend = NULL;
+   struct fp_alu_instr_packet *premul_alu = NULL;
+   struct fp_alu_instr_packet *alpha_alu = NULL, *blend_alu = NULL;
+   int rt;
+
+   if (!grate_blend_take_color_output(fp, &rt))
+      return false;
+   if (!grate_fp_program_counts_supported(
+          list_length(&fp->fp_instructions) + 3,
+          list_length(&fp->mfu_instructions),
+          list_length(&fp->alu_instructions) + 3))
+      return false;
+
+   const unsigned next = list_length(&fp->alu_instructions);
+   premul = grate_blend_exec(next, false, rt);
+   premul_alpha = grate_blend_exec(next + 1, false, rt);
+   blend = grate_blend_exec(next + 2, true, rt);
+   premul_alu = grate_blend_packet();
+   alpha_alu = grate_blend_packet();
+   blend_alu = grate_blend_packet();
+   if (!premul || !premul_alpha || !blend ||
+       !premul_alu || !alpha_alu || !blend_alu)
+      goto oom;
+
+   /*
+    * The shader yields r2/r3 = semantic RGBA fixed10.  Stage 1 saves
+    * src.rgb * src.a into r0.l/r0.h/r1.l, and the ORIGINAL alpha into
+    * r4.l. Stage 2 computes src.a^2 into r1.h. Only stage 3 fetches the
+    * destination (overwriting r2/r3), so alpha remains in r4.l.
+    *
+    * All four components use SRC_ALPHA, including the alpha equation:
+    * src.a * src.a + dst.a * (1 - src.a).
+    */
+   const struct fp_alu_src_operand original_alpha = grate_blend_src(3, true);
+   const struct fp_alu_src_operand saved_alpha = grate_blend_src(4, false);
+   for (unsigned c = 0; c < 3; ++c) {
+      const bool high = c & 1;
+      premul_alu->slots[c] =
+         grate_blend_mul(grate_blend_dst(c / 2, high, false),
+                         grate_blend_src(2 + c / 2, high), original_alpha);
+   }
+   premul_alu->slots[3] =
+      grate_blend_mov(grate_blend_dst(4, false, false), original_alpha);
+   alpha_alu->slots[0] =
+      grate_blend_mul(grate_blend_dst(1, true, false),
+                      saved_alpha, saved_alpha);
+
+   struct fp_alu_src_operand factor = saved_alpha;
+   factor.minus_one = true;
+   for (unsigned c = 0; c < 4; ++c) {
+      const bool high = c & 1;
+      struct fp_alu_src_operand dst =
+         grate_blend_src(2 + c / 2, high);
+      dst.negate = true;
+      blend_alu->slots[c] =
+         grate_blend_mad(grate_blend_dst(c / 2, high, true),
+                         dst, factor, grate_blend_src(c / 2, high));
+   }
+
+   list_addtail(&premul_alu->link, &fp->alu_instructions);
+   list_addtail(&alpha_alu->link, &fp->alu_instructions);
+   list_addtail(&blend_alu->link, &fp->alu_instructions);
+   list_addtail(&premul->link, &fp->fp_instructions);
+   list_addtail(&premul_alpha->link, &fp->fp_instructions);
+   list_addtail(&blend->link, &fp->fp_instructions);
+   fp->info.pseq_to_dw_exec_nb = list_length(&fp->fp_instructions);
+   return true;
+
+oom:
+   FREE(premul); FREE(premul_alpha); FREE(blend);
+   FREE(premul_alu); FREE(alpha_alu); FREE(blend_alu);
+   return false;
+}
