 static bool
+grate_blend_is_disabled_or_replace(const struct pipe_blend_state *blend)
+{
+   if (!blend)
+      return true;
+   if (blend->logicop_enable || blend->independent_blend_enable)
+      return false;
+
+   const struct pipe_rt_blend_state *rt = &blend->rt[0];
+   /* No color-mask register is emitted by this driver. */
+   if (rt->colormask != PIPE_MASK_RGBA)
+      return false;
+
+   if (!rt->blend_enable)
+      return true;
+
+   /* The blend function matters: REVERSE_SUBTRACT with ONE/ZERO is -src. */
+   return rt->rgb_func == PIPE_BLEND_ADD &&
+          rt->alpha_func == PIPE_BLEND_ADD &&
+          rt->rgb_src_factor == PIPE_BLENDFACTOR_ONE &&
+          rt->alpha_src_factor == PIPE_BLENDFACTOR_ONE &&
+          rt->rgb_dst_factor == PIPE_BLENDFACTOR_ZERO &&
+          rt->alpha_dst_factor == PIPE_BLENDFACTOR_ZERO;
+}
