+       grate_fp_program_counts_supported(
+          list_length(&fp.fp_instructions), list_length(&fp.mfu_instructions),
+          list_length(&fp.alu_instructions))) {
+      grate_pack_fp_blob(&fp, blob);
+      *info = fp.info;
+      *valid = true;
+   } else if (grate_debug & GRATE_DEBUG_FORMAT) {
+      fprintf(stderr, "grate: %s variant unavailable (fp=%u mfu=%u alu=%u)\n",
+              name, list_length(&fp.fp_instructions),
+              list_length(&fp.mfu_instructions),
+              list_length(&fp.alu_instructions));
+   }
+   grate_fp_shader_cleanup(&fp);
+}
