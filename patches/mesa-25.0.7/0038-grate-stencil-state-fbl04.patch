+/* The pinned Grate source exercises these operations on full S8 writes.
+ * There is no independently documented programmable write-mask register.
+ */
+static bool
+grate_stencil_op_supported(enum pipe_stencil_op op)
+{
+   return op == PIPE_STENCIL_OP_KEEP ||
+          op == PIPE_STENCIL_OP_ZERO ||
+          op == PIPE_STENCIL_OP_REPLACE;
+}
+
+static bool
+grate_stencil_state_supported(const struct pipe_stencil_state *s)
+{
+   if (!s->enabled)
+      return true;
+   if (s->func < PIPE_FUNC_NEVER || s->func > PIPE_FUNC_ALWAYS)
+      return false;
+   if (!grate_stencil_op_supported(s->fail_op) ||
+       !grate_stencil_op_supported(s->zfail_op) ||
+       !grate_stencil_op_supported(s->zpass_op))
+      return false;
+   return grate_stencil_keep_only(s) || s->writemask == 0xff;
+}
+
+static uint32_t
+grate_stencil_op(enum pipe_stencil_op op)
+{
+   switch (op) {
+   case PIPE_STENCIL_OP_KEEP: return TGR3D_STENCIL_OP_KEEP;
+   case PIPE_STENCIL_OP_ZERO: return TGR3D_STENCIL_OP_ZERO;
+   case PIPE_STENCIL_OP_REPLACE: return TGR3D_STENCIL_OP_REPLACE;
+   default: unreachable("unvalidated stencil operation");
+   }
+}
+
