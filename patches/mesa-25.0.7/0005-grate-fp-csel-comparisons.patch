+/*
+ * Hardware CSEL is (rA < 0) ? rB : (rC * rD), NOT a 4-input compare.
+ * With rD disabled, hardware supplies 1.0 and returns rC on false.
+ */
+static struct fp_alu_instr
+fp_make_csel(struct fp_alu_dst_operand dst,
+             struct fp_alu_src_operand predicate,
+             struct fp_alu_src_operand val_negative,
+             struct fp_alu_src_operand val_nonnegative)
+{
+   return (struct fp_alu_instr) {
+      .op = FP_ALU_OP_CSEL,
+      .dst = dst,
+      .src = { predicate, val_negative, val_nonnegative,
+               fp_src_disabled_one() },
+   };
+}
+
+/* ALU condition_code tests the arithmetic result against zero. */
+static struct fp_alu_instr
+fp_make_compare(enum fp_condition condition,
+                struct fp_alu_dst_operand dst,
+                struct fp_alu_src_operand a,
+                struct fp_alu_src_operand b)
+{
+   b.negate = !b.negate;
+   struct fp_alu_instr instr = fp_make_add(dst, a, b);
+   instr.condition = condition;
+   return instr;
+}
