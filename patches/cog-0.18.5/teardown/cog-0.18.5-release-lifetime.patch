+static void
+cog_drm_exportable_owner_stop(CogDrmExportableOwner *owner)
+{
+    if (!owner->renderer)
+        return;
+    if (owner->renderer->stop_exportable)
+        owner->renderer->stop_exportable(owner->renderer);
+    owner->renderer = NULL;
+}
+
+static void
+cog_drm_exportable_owner_destroy(gpointer data)
+{
+    CogDrmExportableOwner *owner = data;
+    cog_drm_exportable_owner_stop(owner);
+    if (owner->platform)
+        owner->platform->export_owner = NULL;
+    wpe_view_backend_exportable_fdo_destroy(owner->exportable);
+    g_free(owner);
+}
